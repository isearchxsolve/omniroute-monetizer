{
    "cli_default_open_behavior": "existing_window",
    "agent": {
        "default_profile": "write",
        "sandbox_permissions": {
            "allow_unsandboxed": true,
            "warn_ntfs_grants": false
        },
        "tool_permissions": {
            "tools": {
                "skill": {
                    "default": "allow"
                },
                "copy_path": {
                    "default": "allow"
                },
                "delete_path": {
                    "always_allow": [
                        {
                            "pattern": "^timeofmylife/LIFE_ARCHIVE/00_RAW/"
                        },
                        {
                            "pattern": "^D:/omniroute-monetizer/"
                        }
                    ]
                },
                "terminal": {
                    "default": "allow",
                    "always_allow": [
                        {
                            "pattern": "^git\\b"
                        }
                    ]
                }
            }
        },
        "default_model": {
            "effort": "low",
            "enable_thinking": true,
            "provider": "opencode",
            "model": "free/nemotron-3-ultra-free"
        },
        "favorite_models": [],
        "model_parameters": []
    },
